# ローカル開発専用の php.ini（extension_dir に環境固有の絶対パスを含むため追跡しない）
dev/php.ini

# ローカル確認用の使い捨てDB・ログ・レート制限（架空データのみ。追跡しない）
dev/.preview/

# 保持削除の通し確認が作る使い捨てDB。正常終了すれば消えるが、途中で落ちたときの保険
dev/.walkthrough-*/

# バックアップの通し確認が作る使い捨てDB・使い捨てバックアップ（4G）
dev/.backup-walkthrough-*/

# 配置境界・通知・preflight の通し確認が作る使い捨て領域（4H-R0）
dev/.boundary-walkthrough-*/

# 実設定（HMAC鍵・暗号鍵・受信先）。サーバーにのみ置き、Gitへは入れない。
private/intake-config.php

# APP_ROOT の実パスを書く非公開 bootstrap（4H-R0）。実体はサーバーにのみ置く。
private/app-root-bootstrap.php

# preflight 専用領域（本番配置後の通し確認・架空データのみ）。追跡しない。
private/preflight/

# 実行時に生成されるもの
private/ratelimit/
private/*.sqlite
private/*.sqlite-journal
private/logs/
# バックアップの実体（4G）。★DB本体と同じ中身が入る。絶対に追跡しない
private/backups/
tests/.tmp/
