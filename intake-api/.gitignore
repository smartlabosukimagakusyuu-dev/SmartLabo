# ローカル開発専用の php.ini（extension_dir に環境固有の絶対パスを含むため追跡しない）
dev/php.ini

# ローカル確認用の使い捨てDB・ログ・レート制限（架空データのみ。追跡しない）
dev/.preview/

# 保持削除の通し確認が作る使い捨てDB。正常終了すれば消えるが、途中で落ちたときの保険
dev/.walkthrough-*/

# 実設定（HMAC鍵・暗号鍵・受信先）。サーバーにのみ置き、Gitへは入れない。
private/intake-config.php

# 実行時に生成されるもの
private/ratelimit/
private/*.sqlite
private/*.sqlite-journal
private/logs/
tests/.tmp/
