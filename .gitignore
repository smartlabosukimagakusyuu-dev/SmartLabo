# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Dependencies (future use)
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# API の実設定ファイル(受信先メールアドレス・署名鍵)。サーバーにのみ置き、Gitへは入れない。
# contact-api/.gitignore・signup-api/.gitignore は website-v3 ブランチにしか無いため、
# master をチェックアウトした状態でも確実に除外されるようルートにも同じ規則を置く。
contact-api/private/contact-config.php
contact-api/private/ratelimit/
signup-api/private/signup-config.php
signup-api/private/ratelimit/

# intake-api（HP導入フォーム受付API）
# 実設定（HMAC鍵・暗号鍵）・DB実体・実行時生成物・環境固有の絶対パスを含む php.ini は入れない。
intake-api/private/intake-config.php
intake-api/private/ratelimit/
intake-api/private/logs/
intake-api/private/*.sqlite
intake-api/private/*.sqlite-journal
intake-api/dev/php.ini
intake-api/tests/.tmp/

# Logs
*.log
